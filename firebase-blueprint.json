{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile stored in Firestore containing role, approval status, privacy settings, academic/office details, and career info",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "name": { "type": "string", "maxLength": 100 },
        "role": { "type": "string", "enum": ["student", "alumni", "admin", "superAdmin"] },
        "baustId": { "type": "string", "maxLength": 40 },
        "department": { "type": "string", "maxLength": 50 },
        "batch": { "type": "string", "maxLength": 50 },
        "office": { "type": "string", "maxLength": 100 },
        "employeeId": { "type": "string", "maxLength": 40 },
        "avatar": { "type": "string" },
        "phone": { "type": "string", "maxLength": 30 },
        "bio": { "type": "string", "maxLength": 1000 },
        "isVerified": { "type": "boolean" },
        "verifiedAlumniBadge": { "type": "boolean" },
        "isFeatured": { "type": "boolean" },
        "hidePhone": { "type": "boolean" },
        "hideEmail": { "type": "boolean" },
        "profileVisibility": { "type": "string", "enum": ["public", "private"] },
        "isDemo": { "type": "boolean" },
        "suspended": { "type": "boolean" },
        "verificationStatus": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "accountStatus": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "rejectionReason": { "type": "string" },
        "documentType": { "type": "string" },
        "documentFileName": { "type": "string" },
        "documentPreviewUrl": { "type": "string" },
        "verificationProofUrl": { "type": "string" },
        "studentId": { "type": "string" },
        "currentSemester": { "type": "string" },
        "cgpa": { "type": "number" },
        "careerGoal": { "type": "string" },
        "interests": { "type": "array" },
        "cvFileName": { "type": "string" },
        "designation": { "type": "string" },
        "company": { "type": "string" },
        "sector": { "type": "string" },
        "location": { "type": "string" },
        "passingYear": { "type": "number" },
        "linkedin": { "type": "string" },
        "github": { "type": "string" },
        "skills": { "type": "array" },
        "mentoringAvailable": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "uid", "email", "name", "role", "verificationStatus", "createdAt"]
    },
    "IdIndexEntry": {
      "title": "IdIndexEntry",
      "description": "BAUST ID lookup index for unique registration enforcement and Email-or-BAUST-ID sign-in",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["student", "alumni", "admin", "superAdmin"] },
        "isDemo": { "type": "boolean" }
      },
      "required": ["uid", "email", "role"]
    },
    "VerificationRequest": {
      "title": "VerificationRequest",
      "description": "Student/Alumni/Admin registration verification request reviewed exclusively by Super Admin",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["student", "alumni", "admin"] },
        "baustId": { "type": "string" },
        "department": { "type": "string" },
        "batch": { "type": "string" },
        "passingYear": { "type": "number" },
        "office": { "type": "string" },
        "designation": { "type": "string" },
        "verificationProofUrl": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "reason": { "type": "string" },
        "reviewedBy": { "type": "string" },
        "submittedAt": { "type": "string" }
      },
      "required": ["id", "userId", "name", "role", "status", "submittedAt"]
    },
    "JobPosting": {
      "title": "JobPosting",
      "description": "Job or internship opportunity posted by approved Alumni, Admin, or Super Admin",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "company": { "type": "string" },
        "location": { "type": "string" },
        "type": { "type": "string" },
        "department": { "type": "string" },
        "postedById": { "type": "string" },
        "postedByRole": { "type": "string" },
        "status": { "type": "string", "enum": ["Open", "Closed"] },
        "isDemo": { "type": "boolean" }
      },
      "required": ["title", "company", "postedById", "status"]
    },
    "JobApplication": {
      "title": "JobApplication",
      "description": "Student application to a job or internship posting",
      "type": "object",
      "properties": {
        "jobId": { "type": "string" },
        "studentId": { "type": "string" },
        "postedBy": { "type": "string" },
        "postedById": { "type": "string" },
        "postedByName": { "type": "string" },
        "postedByRole": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["Applied", "Under Review", "Shortlisted", "Interview", "On Hold", "Accepted", "Rejected", "Withdrawn", "Job Removed"]
        },
        "statusHistory": { "type": "array" },
        "isDemo": { "type": "boolean" }
      },
      "required": ["jobId", "studentId", "status"]
    },
    "Mentorship": {
      "title": "Mentorship",
      "description": "Mentorship request and scheduled session between student and specific alumni mentor",
      "type": "object",
      "properties": {
        "studentId": { "type": "string" },
        "alumniId": { "type": "string" },
        "mentorId": { "type": "string" },
        "topic": { "type": "string" },
        "message": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["Pending", "On Hold", "Accepted", "Declined", "Completed", "Cancelled"]
        },
        "statusHistory": { "type": "array" }
      },
      "required": ["studentId", "alumniId", "topic", "status"]
    },
    "KnowledgeSession": {
      "title": "KnowledgeSession",
      "description": "Live knowledge-sharing webinars and seminars hosted by alumni or admins",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "topic": { "type": "string" },
        "hostId": { "type": "string" },
        "date": { "type": "string" },
        "time": { "type": "string" },
        "maxSeats": { "type": "number" },
        "registeredIds": { "type": "array" },
        "status": { "type": "string", "enum": ["Scheduled", "Live", "Completed", "Cancelled"] }
      },
      "required": ["title", "hostId", "date", "status"]
    },
    "AppointmentSlot": {
      "title": "AppointmentSlot",
      "description": "One-to-one alumni mentorship time slot booked atomically via Firestore transactions",
      "type": "object",
      "properties": {
        "alumniId": { "type": "string" },
        "date": { "type": "string" },
        "timeSlot": { "type": "string" },
        "status": { "type": "string", "enum": ["available", "booked", "cancelled", "completed"] },
        "bookedByStudentId": { "type": "string" }
      },
      "required": ["alumniId", "date", "timeSlot", "status"]
    },
    "CVReview": {
      "title": "CVReview",
      "description": "Student CV review request and structured alumni mentor feedback",
      "type": "object",
      "properties": {
        "studentId": { "type": "string" },
        "mentorId": { "type": "string" },
        "targetRole": { "type": "string" },
        "cvFileName": { "type": "string" },
        "status": { "type": "string", "enum": ["Submitted", "In Review", "Reviewed"] },
        "score": { "type": "number" }
      },
      "required": ["studentId", "mentorId", "targetRole", "status"]
    },
    "Evaluation": {
      "title": "Evaluation",
      "description": "Verified student rating and evaluation for completed mentorship or CV review",
      "type": "object",
      "properties": {
        "studentId": { "type": "string" },
        "alumniId": { "type": "string" },
        "rating": { "type": "number" },
        "comment": { "type": "string" }
      },
      "required": ["studentId", "alumniId", "rating"]
    },
    "Conversation": {
      "title": "Conversation",
      "description": "Direct messaging thread between two authenticated BAUST users",
      "type": "object",
      "properties": {
        "participantIds": { "type": "array" },
        "participants": { "type": "object" },
        "lastMessage": { "type": "string" },
        "lastMessageAt": { "type": "string" },
        "lastSenderId": { "type": "string" },
        "unreadCount": { "type": "object" },
        "source": { "type": "string", "enum": ["mentorship", "directory", "job"] },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["participantIds"]
    },
    "EventItem": {
      "title": "EventItem",
      "description": "BAUST alumni summit, workshop, or career event",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "organizerId": { "type": "string" },
        "attendeeIds": { "type": "array" },
        "isDemo": { "type": "boolean" }
      },
      "required": ["title", "organizerId"]
    },
    "Announcement": {
      "title": "Announcement",
      "description": "Official university announcement published by Admin or Super Admin",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "category": { "type": "string" },
        "targetAudience": { "type": "string" },
        "content": { "type": "string" },
        "authorId": { "type": "string" }
      },
      "required": ["title", "content"]
    },
    "ContributionItem": {
      "title": "ContributionItem",
      "description": "Alumni giving-back pledge or scholarship/equipment donation",
      "type": "object",
      "properties": {
        "alumniId": { "type": "string" },
        "category": { "type": "string" },
        "amountBdt": { "type": "number" },
        "status": { "type": "string" }
      },
      "required": ["alumniId", "category"]
    },
    "DocumentRequest": {
      "title": "DocumentRequest",
      "description": "Transcript, certificate, or clearance document request with Admin-controlled 6-stage lifecycle",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "trackingId": { "type": "string" },
        "userId": { "type": "string" },
        "type": { "type": "string" },
        "status": { "type": "string" },
        "stages": { "type": "array" },
        "currentStageIndex": { "type": "number" },
        "currentStageKey": { "type": "string" },
        "deliveryInfo": { "type": "object" },
        "adminRemarks": { "type": "string" },
        "deliveryUrl": { "type": "string" },
        "pickupInfo": { "type": "string" },
        "statusHistory": { "type": "array" }
      },
      "required": ["id", "trackingId", "userId", "type", "status"]
    },
    "AppNotification": {
      "title": "AppNotification",
      "description": "In-app notification generated by platform workflow triggers",
      "type": "object",
      "properties": {
        "recipientId": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "type": { "type": "string" },
        "link": { "type": "string" },
        "refId": { "type": "string" },
        "read": { "type": "boolean" }
      },
      "required": ["recipientId", "title", "read"]
    },
    "ModerationReport": {
      "title": "ModerationReport",
      "description": "User or content safety report reviewed by Admin and Super Admin",
      "type": "object",
      "properties": {
        "reporterId": { "type": "string" },
        "targetId": { "type": "string" },
        "targetType": { "type": "string", "enum": ["user", "job", "session", "message"] },
        "reason": { "type": "string" },
        "status": { "type": "string", "enum": ["Pending", "Reviewed", "Action Taken", "Dismissed"] }
      },
      "required": ["reporterId", "targetId", "reason", "status"]
    },
    "ActivityLog": {
      "title": "ActivityLog",
      "description": "Governance audit trail viewed exclusively by Super Admin",
      "type": "object",
      "properties": {
        "actorId": { "type": "string" },
        "actorRole": { "type": "string" },
        "action": { "type": "string" },
        "targetId": { "type": "string" },
        "details": { "type": "string" }
      },
      "required": ["actorId", "action"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profiles partitioned by Firebase Auth UID"
    },
    "/idIndex/{baustId}": {
      "schema": { "$ref": "#/entities/IdIndexEntry" },
      "description": "BAUST ID uniqueness index and Email-or-ID sign-in lookup"
    },
    "/verificationRequests/{verificationId}": {
      "schema": { "$ref": "#/entities/VerificationRequest" },
      "description": "Registration approval queue controlled exclusively by Super Admin"
    },
    "/jobs/{jobId}": {
      "schema": { "$ref": "#/entities/JobPosting" },
      "description": "Jobs and internships posted by Alumni, Admin, or Super Admin"
    },
    "/jobApplications/{appId}": {
      "schema": { "$ref": "#/entities/JobApplication" },
      "description": "Student job applications"
    },
    "/mentorships/{mentorshipId}": {
      "schema": { "$ref": "#/entities/Mentorship" },
      "description": "Live mentorship bookings between students and alumni"
    },
    "/knowledgeSessions/{sessionId}": {
      "schema": { "$ref": "#/entities/KnowledgeSession" },
      "description": "Live knowledge-sharing sessions and webinars"
    },
    "/appointments/{slotId}": {
      "schema": { "$ref": "#/entities/AppointmentSlot" },
      "description": "1-to-1 alumni appointment slots with atomic booking"
    },
    "/cvReviews/{reviewId}": {
      "schema": { "$ref": "#/entities/CVReview" },
      "description": "Student CV review submissions and mentor evaluations"
    },
    "/evaluations/{evalId}": {
      "schema": { "$ref": "#/entities/Evaluation" },
      "description": "Verified student mentor evaluations and ratings"
    },
    "/conversations/{convId}": {
      "schema": { "$ref": "#/entities/Conversation" },
      "description": "Direct messaging conversations and /messages subcollection"
    },
    "/events/{eventId}": {
      "schema": { "$ref": "#/entities/EventItem" },
      "description": "Alumni summits and networking events"
    },
    "/announcements/{announcementId}": {
      "schema": { "$ref": "#/entities/Announcement" },
      "description": "University career circulars and announcements"
    },
    "/contributions/{contributionId}": {
      "schema": { "$ref": "#/entities/ContributionItem" },
      "description": "Alumni giving-back pledges and contributions"
    },
    "/documentRequests/{requestId}": {
      "schema": { "$ref": "#/entities/DocumentRequest" },
      "description": "Official academic transcript, certificate, and clearance requests"
    },
    "/notifications/{notifId}": {
      "schema": { "$ref": "#/entities/AppNotification" },
      "description": "Workflow notifications per user and role group"
    },
    "/reports/{reportId}": {
      "schema": { "$ref": "#/entities/ModerationReport" },
      "description": "Safety and content moderation reports"
    },
    "/activityLogs/{logId}": {
      "schema": { "$ref": "#/entities/ActivityLog" },
      "description": "System audit log readable by Super Admin"
    }
  }
}
